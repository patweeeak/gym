# Copy to .env.local and fill in from Supabase: Project Settings → API.
# Without these, the app runs on local storage with demo data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only for `npm run db:seed` on your machine. Secret: never prefix it with VITE_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Online payments (Xendit). Secret: set as Supabase function secrets, never VITE_-prefixed.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
